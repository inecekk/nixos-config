// 环境变量
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"

environment {
    GDK_BACKEND "wayland"
    QT_QPA_PLATFORM "wayland;xcb"
    SDL_VIDEODRIVER "wayland"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    _JAVA_AWT_WM_NONREPARENTING "1"
}
prefer-no-csd

// 输入设备
input {
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse
}

cursor {
    xcursor-size 20
}

output "eDP-1" {
    scale 2.0
}

hotkey-overlay {
    skip-at-startup
}

// ========== 概览设置 ==========
overview {
    zoom 0.5
    backdrop-color "#00000080"
    workspace-shadow {
        on
    }
}

// ========== 动画系统 ==========
animations {
    workspace-switch {
        spring damping-ratio=0.62 stiffness=400 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.62 stiffness=400 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.62 stiffness=400 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.75 stiffness=500 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.5 stiffness=500 epsilon=0.0001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.5 stiffness=500 epsilon=0.0001
    }
    screenshot-ui-open {
        spring damping-ratio=0.75 stiffness=500 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=0.75 stiffness=500 epsilon=0.0001
    }
    window-close {
        duration-ms 400
        curve "linear"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float progress = niri_clamped_progress * niri_clamped_progress;
                vec2 coords = (coords_geo.xy - vec2(0.0, 1.0)) * size_geo.xy;
                float angle = progress * 0.7;
                mat2 rotate = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
                coords = rotate * coords;
                coords += vec2(progress * 0.15, progress * 0.15) * size_geo.xy;
                coords_geo = vec3(coords / size_geo.xy + vec2(0.0, 1.0), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * (1.0 - niri_clamped_progress);
            }
        "
    }
    window-open {
        duration-ms 400
        curve "linear"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float inv = 1.0 - niri_clamped_progress;
                float progress = inv * inv;
                vec2 coords = (coords_geo.xy - vec2(0.0, 1.0)) * size_geo.xy;
                float angle = progress * 0.7;
                mat2 rotate = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
                coords = rotate * coords;
                coords += vec2(progress * 0.15, progress * 0.15) * size_geo.xy;
                coords_geo = vec3(coords / size_geo.xy + vec2(0.0, 1.0), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * niri_clamped_progress;
            }
        "
    }
}

// ========== 布局 ==========
layout {
    background-color "transparent"
    gaps 8
    struts {
	left  2
	right 2
	top 1
	bottom 1
	}
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    default-column-width {
        proportion 0.5
    }
    tab-indicator {
        active-color "#ffb68f"
        inactive-color "#773200"
        urgent-color "#ffb4ab"
    }
    insert-hint {
        color "#ffb68f80"
    }
    focus-ring {
        width 2
        active-gradient from="#ef4444cc" to="#e879f9cc" angle=90 in="oklch longer hue" relative-to="workspace-view"
        inactive-color "#50505020"
    }
    border {
        off
    }
    shadow {
        softness 35
        spread 6
        offset x=0 y=6
        color "#0007"
    }
}

// ========== 模糊效果 ==========
blur {
    passes 4
    offset 2.5
    noise 0.03
    saturation 1.3
}

// ========== 窗口规则 ==========
// 全局默认规则
window-rule {
    default-column-width {
        proportion 0.5
    }
    default-window-height {
        proportion 1.0
    }
    opacity 0.85
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// Zen 浏览器
window-rule {
    match app-id=r#"^(zen|zen-alpha|zen-browser|zen-bin)$"#
    open-maximized true
    background-effect {
        blur true
        xray true
    }
}

// Foot 终端
window-rule {
    match app-id="^foot$"
    open-maximized false
    default-column-width {
        proportion 0.5
    }
    background-effect {
        blur false
        xray false
    }
}

// musicfox
window-rule {
    match app-id="^foot$" title="^musicfox$"
    opacity 0.5
    default-window-height {
        proportion 1.0
    }
}

// SpaceFM
window-rule {
    match app-id="^spacefm"
    opacity 0.92
    background-effect {
        blur true
        xray true
    }
}
// ========== Noctalia 图层规则 ==========
// 壁纸 - 不模糊，作为背景
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
    background-effect {
	    blur false
	    xray false
    }
}


// Noctalia 设置界面
layer-rule {
    match namespace="^noctalia-settings$"
    background-effect {
        blur false
        xray false
    }
}


// Noctalia 其他组件
layer-rule {
    match namespace="^noctalia-(bar-.*|panel|attached-panel|notification|dock|osd|launcher|clipboard|control-center|overlay|greeter)$"
    background-effect {
        blur false
        xray false
    }
}
// Fcitx5 输入法
layer-rule {
    match namespace="^fcitx"
    background-effect {
        blur true
        xray true
    }
}


spawn-at-startup "sh" "-c" "noctalia"
spawn-at-startup "sh" "-c" "fcitx5"
spawn-at-startup "sh" "-c" "while true; do sleep 3600; fcitx5 -r -d; done"

include "binds.kdl"

recent-windows {
    highlight {
        active-color "#ffb68f"
        urgent-color "#ffb4ab"
    }
}
